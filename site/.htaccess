# A beállítófájl, a belső PHP-fájlok és az adatbázisok közvetlenül nem tölthetők le.
<FilesMatch "^(counter-config(\.sample)?\.php|push-lib\.php|push-keygen\.php|.*\.sqlite.*)$">
  Require all denied
</FilesMatch>
Options -Indexes
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest|.*\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
